rules_version = '2';
// Dán toàn bộ nội dung này vào Firebase Console → Firestore Database → Rules → Publish.
// Thay email bên dưới bằng email quản trị viên (giống trong firebase-config.js).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function adminEmail() {
      return signedIn() && request.auth.token.email in [];
    }
    function isAdmin() {
      return adminEmail() ||
        (signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    function approvalOn() {
      return exists(/databases/$(db)/documents/settings/app) &&
        get(/databases/$(db)/documents/settings/app).data.requireApproval == true;
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // tự tạo hồ sơ: luôn là học viên; nếu bật duyệt thì phải ở trạng thái chờ duyệt
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'student' &&
        (adminEmail() || !approvalOn() || request.resource.data.status == 'pending');
      // học viên tự lưu tiến độ nhưng không được tự đổi vai trò / trạng thái
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));
      allow delete: if isAdmin();
    }
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
